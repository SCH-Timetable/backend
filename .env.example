# MySQL connection used by the FastAPI backend
DATABASE_URL=mysql+pymysql://bua_user:change_me@127.0.0.1:3306/bua_project
JWT_SECRET=replace-with-a-long-random-secret

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Google Gemini API key for the chatbot (optional — falls back to rule-based answers)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for chat answers (must support generateContent)
GEMINI_MODEL=gemini-3.6-flash
